tasks = Array[String](["Be happy in life", "Your bus is late, you are going to be late to work.", "You get your morning coffee, but the cup slips and breaks.", "Your favourite lunch restaurant is closing down.", "Your work announces lay offs.", "You book some holidays but they were very expensive.", "Your bank account gets hacked. You spend two hours with customer care.", "Your friend gets promoted at work. You are happy for them. No really.", "You get your money back but it's time for taxes.", "You win a lottery but it's only $10", "Silksong releases. You are finally playing the game.", "Heavy rain floods your basement.", "Landlord will take care of the basement but they need to empty the house.", "You find a new favourite lunch restaurant.", "You find out your crush is getting married.", "Your sibling has a stroke. They are only 31.", "Your Sibling recovers but you can tell they are different.", "You get a new job offer but what about your friends.", "WHO announces a new pandemic. You are not going on a holiday.", "You learn to make bread. House smells nice.", "Your job offer is rescinded. You already gave your notice.", "You still have a job but you know another layoff is coming.", "You find a new job before layoffs start.", "You go on a holiday and find a cat following you.", "Your cat sleeps on your chest purring loudly."])
aim = "Be happy in life"

